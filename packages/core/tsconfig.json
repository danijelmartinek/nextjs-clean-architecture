{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "noEmitOnError": false,
    "paths": {
      "@repo/core/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
